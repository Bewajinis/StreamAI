# Server-side only. Never prefix this with NEXT_PUBLIC_.
# Copy this file to .env.local and fill in your own value.
#
# ANTHROPIC_API_KEY is only needed in Anthropic mode (see CHAT_MODE below).

# Reply engine for POST /api/chat: "mock" or "anthropic".
#   - Leave unset: mock under `next dev` (NODE_ENV=development), anthropic for
#     production, tests and an unset NODE_ENV. Mock is never a silent default
#     outside the dev server.
#   - Development with a funded key: CHAT_MODE=anthropic
#   - Deliberate mock (any environment, including production): CHAT_MODE=mock
# The active mode is reported in the `x-chat-mode` response header; mock
# replies are additionally labelled in the transcript.
CHAT_MODE=

# --- Development mock stream pacing (ignored in anthropic mode) ------------
# Pause before the first token, in ms — keeps the thinking indicator visible.
MOCK_INITIAL_DELAY_MS=
# Pause between tokens, in ms — the stream's words-per-second rate.
MOCK_TOKEN_DELAY_MS=

# Optional overrides (defaults are defined in src/lib/ai/config.ts).
ANTHROPIC_MODEL=

# Optional: route requests through a proxy or self-hosted gateway instead of
# Anthropic's official endpoint. Leave unset to use https://api.anthropic.com.
# NOTE: a value already exported in your shell overrides anything set here.
ANTHROPIC_BASE_URL=
